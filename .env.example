# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
API_KEY=your-secret-api-key-here

# Qdrant (Vector DB)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=caso_chunks

# Neo4j (Graph DB)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=casorag_neo4j_password

# PostgreSQL (Relational DB)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=caso_db
POSTGRES_USER=caso_user
POSTGRES_PASSWORD=casorag_postgres_password
# This URL is used by SQLAlchemy to connect to Postgres
DATABASE_URL=postgresql+asyncpg://caso_user:casorag_postgres_password@localhost:5432/caso_db

# Redis (Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=casorag_redis_password
REDIS_CACHE_TTL_SECONDS=3600

# LLM Configuration
LLM_BACKEND=huggingface                      
LLM_MODEL_NAME=meta-llama/Meta-Llama-3.1-8B-Instruct
LLM_QUANTIZATION=4bit                        
LLM_MAX_NEW_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_DEVICE=auto

EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# HuggingFace
HF_TOKEN=your-huggingface-token
HF_CACHE_DIR=./data/models